  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile benchmark",
      "type": "shell",
      "command": "g++ mybenchmark.cc -std=c++11 -isystem benchmark/include -Lbenchmark/build/src -lbenchmark -lpthread -o mybenchmark"
    },
    {
      "label": "compile-g++",
      "type": "shell",
      "command": "g++ -std=c++23 -g ${file} -o ${fileDirname}/${fileBasenameNoExtension} -fsanitize=address,undefined "
    }
  ]
}